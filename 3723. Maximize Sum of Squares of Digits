
class Solution {
    public String maxSumOfSquares(int num, int sum) {
        if (sum > 9 * num) {
            return "";
        }

        StringBuilder ans = new StringBuilder();

        while (sum > 0 && num > 0) {
            int digit = Math.min(9, sum);
            ans.append(digit);
            sum -= digit;
            num--;
        }

        while (num > 0) {
            ans.append('0');
            num--;
        }

        return ans.toString();
    }
}
